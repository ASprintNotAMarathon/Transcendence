# this needs to be copied to .env and adjusted. .env is gitignored; this file is committed

# ---Postgres---
POSTGRES_USER=transcendence

# the password is embedded in DATABASE_URL, where @ : / ? # % are structural characters.
# Must match [A-Za-z0-9._~-]+ - generate with: openssl rand -hex 24
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transcendence


# ---Ports---
# published on localhost/127.0.0.1 only
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=5173


# ---API---
# API - Application Programming Interface (NestJS in our case)
# JWT - JSON Web Token
# generate a real one with: openssl rand -hex 32
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32

# Host-side tooling only, in Prisma's URL format. '?schema=' is a Prisma extension that libpq rejects,
# so psql and most GUIs need it stripped:
# 	psql "postgresql://user:pass@localhost:5432/transcendence"
# The containers do not read this, compose sets their own DATABASE_URL using the 'db' hostname,
# because 'localhost' inside a container means that container, not local machine.
DATABASE_URL=postgresql://transcendence:changeme@localhost:5432/transcendence?schema=public
